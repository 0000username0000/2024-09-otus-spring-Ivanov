<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="4" author="your_name">
        <insert tableName="roles">
            <column name="name" value="USER"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ADMIN"/>
        </insert>
    </changeSet>

    <changeSet id="5" author="your_name">
        <insert tableName="users">
            <column name="login" value="anton"/>
            <column name="password" value="1234"/>
            <column name="first_name" value="Антон"/>
            <column name="last_name" value="Иванов"/>
        </insert>

        <insert tableName="users_roles">
            <column name="user_id" valueComputed="(SELECT id FROM users WHERE login = 'anton')"/>
            <column name="role_id" valueComputed="(SELECT id FROM roles WHERE name = 'USER')"/>
        </insert>

        <insert tableName="users">
            <column name="login" value="ivan"/>
            <column name="password" value="12345"/>
            <column name="first_name" value="Сергей"/>
            <column name="last_name" value="Петров"/>
        </insert>

        <insert tableName="users_roles">
            <column name="user_id" valueComputed="(SELECT id FROM users WHERE login = 'ivan')"/>
            <column name="role_id" valueComputed="(SELECT id FROM roles WHERE name = 'ADMIN')"/>
        </insert>
    </changeSet>
</databaseChangeLog>