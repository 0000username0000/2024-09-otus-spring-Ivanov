<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="2" author="Artem">
        <createTable tableName="product_category">
            <column name="product_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="product_category" baseColumnNames="product_id"
                                 constraintName="fk_product_category_product"
                                 referencedTableName="product" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="product_category" baseColumnNames="category_id"
                                 constraintName="fk_product_category_category"
                                 referencedTableName="category" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>